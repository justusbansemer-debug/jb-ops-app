# Copy this file to ".env.local" and fill in your real values from Supabase.
#
# Where to find these:
#   1. Go to your project at supabase.com
#   2. Click "Project Settings" (gear icon) -> "API Keys"
#      (or just click the "Connect" button on your project's dashboard —
#      it shows both values ready to copy)
#   3. "Project URL" goes below as NEXT_PUBLIC_SUPABASE_URL
#   4. The "Publishable key" (starts with sb_publishable_...) goes below
#      as NEXT_PUBLIC_SUPABASE_ANON_KEY — yes, the variable name still says
#      "ANON_KEY", that's just this project's naming, the value is the
#      Publishable key
#
# Never share the "Secret key" (or old "service_role" key) or commit this
# file to GitHub — .env.local is already ignored by git for you.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
